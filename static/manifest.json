{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.1",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "{762e7a0e-a0e4-4939-93c3-71fc01c441d7}",
      "strict_min_version": "159.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "toggle-sync": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdToggleSync__"
    },
    "toggle-link": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_cmdToggleLink__"
    },
    "focus-other": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "__MSG_cmdFocusOther__"
    },
    "swap-sides": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "__MSG_cmdSwapSides__"
    }
  }
}
